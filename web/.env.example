# Copie para web/.env.production e preencha com os dados do app Web
# (Console do Firebase → Configurações do projeto → Seus apps → SDK).
# Estes valores são públicos por natureza; a proteção está nas regras.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging → Configuração da Web → Certificados push da Web (par de chaves)
VITE_FIREBASE_VAPID_KEY=

# Deixe false em produção
VITE_USE_EMULATORS=false
