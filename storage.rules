rules_version = '2';

// Fotos da zeladoria: issues/{uid}/{issueId}/{arquivo}
//
// Estas regras consultam o Firestore (firestore.get) para saber quem é da
// equipe. Isso exige o papel "Firebase Rules Firestore Service Agent" na
// conta de serviço do Storage: publique com `firebase deploy --only storage`
// num terminal interativo e responda "sim" (com --non-interactive o CLI pula
// essa etapa e a equipe deixa de ver as fotos).
// Substitui o bucket MinIO público do backend antigo — agora as fotos só
// são visíveis para quem abriu a solicitação e para a equipe da prefeitura.
service firebase.storage {
  match /b/{bucket}/o {
    function isManager() {
      let staffPath = /databases/(default)/documents/staff/$(request.auth.uid);
      return request.auth != null
        && firestore.exists(staffPath)
        && firestore.get(staffPath).data.active == true
        && firestore.get(staffPath).data.roles.hasAny(['ROOT', 'CIVIL_SERVANT']);
    }

    match /issues/{userId}/{issueId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isManager());
      // Sem sobrescrever (resource == null) e só formatos de foto comuns
      allow create: if request.auth != null
        && request.auth.uid == userId
        && resource == null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
